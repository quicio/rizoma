---
import { kndlHome, withBase } from '../lib/site';

interface Props {
  exploracionUrl?: string;
  exploracionTitle?: string;
  current?: string;
}

const { exploracionUrl, exploracionTitle, current } = Astro.props;
---

<nav class="reading-breadcrumb rz-breadcrumb" aria-label="Ruta">
  <a href={withBase('/')}>Rizoma</a>
  {exploracionUrl && (
    <>
      <span aria-hidden="true">/</span>
      <a href={exploracionUrl}>{exploracionTitle || 'Exploración'}</a>
    </>
  )}
  {current && (
    <>
      <span aria-hidden="true">/</span>
      <span class="rz-breadcrumb__current" aria-current="page">{current}</span>
    </>
  )}
  <span aria-hidden="true">/</span>
  <a href={kndlHome()}>KNDL</a>
</nav>
