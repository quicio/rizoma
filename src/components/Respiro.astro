---
import { kndlHref, kndlPreviewHref } from '../lib/site';

interface Props {
  respiro: { texto: string; fuente: string; fuente_titulo: string };
}

const { respiro } = Astro.props;
---

<figure class="expediente__respiro">
  <blockquote class="expediente__respiro-texto" set:html={respiro.texto.replace(/\n/g, '<br />')} />
  {respiro.fuente && (
    <figcaption class="expediente__respiro-fuente">
      <a href={kndlHref(respiro.fuente)} data-corpus-preview data-corpus-url={kndlPreviewHref(respiro.fuente)} data-corpus-kind="Respiro" data-corpus-title={respiro.fuente_titulo || respiro.fuente} aria-haspopup="dialog" title={`Vista rápida: ${respiro.fuente_titulo || respiro.fuente}`}>{respiro.fuente_titulo || respiro.fuente}</a>
    </figcaption>
  )}
</figure>
