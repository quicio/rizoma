---
import '../styles/style.css';
import { SITE, absoluteUrl, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  bodyClass?: string;
  seoTitle?: string;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  bodyClass = 'reading-poemas reading-rizoma',
  seoTitle,
} = Astro.props;

const pageTitle = seoTitle || (title ? `${title} · ${SITE.title}` : SITE.title);
const canonical = absoluteUrl(Astro.url.pathname);
const ogType = 'website';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Lato:ital,wght@0,300;0,400;0,700;1,400&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    {
      SITE.ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>
          <script is:inline define:vars={{ ga4: SITE.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
  </head>
  <body class={bodyClass}>
    <main class="reading-main">
      <slot />
    </main>
  </body>
</html>
