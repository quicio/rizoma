---
import '../styles/style.css';
import '../styles/rizoma.css';
import { SITE, absoluteUrl, withBase } from '../lib/site';
import RizomaHeader from '../components/RizomaHeader.astro';
import RizomaFooter from '../components/RizomaFooter.astro';
import RizomaResource from '../components/RizomaResource.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  bodyClass?: string;
  seoTitle?: string;
}

const {
  title,
  description = SITE.description,
  noindex = false,
  bodyClass = 'reading-rizoma',
  seoTitle,
} = Astro.props;

const pageTitle = seoTitle || (title ? `${title} · ${SITE.title}` : SITE.title);
const canonical = absoluteUrl(Astro.url.pathname);
const ogType = 'website';
const classes = bodyClass
  .split(/\s+/)
  .filter(Boolean)
  .includes('rizoma')
  ? bodyClass
  : `${bodyClass} rizoma`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#171614" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/media/rizoma/glyph.svg')} />
    <link rel="alternate icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,300..700;1,400&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=JetBrains+Mono:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    {
      SITE.ga4 && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>
          <script is:inline define:vars={{ ga4: SITE.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', ga4);
          </script>
        </>
      )
    }
  </head>
  <body class={classes} data-base={withBase('/')} style={`--rz-terrain: url("${withBase('/assets/plates/terrain.webp')}")`}>
    <a class="rz-skip" href="#contenido">Saltar al contenido</a>
    <RizomaHeader />
    <main class="reading-main rz-main" id="contenido">
      <slot />
    </main>
    <RizomaFooter />
    <RizomaResource />
    <script is:inline src={withBase('/rizoma-search.js')} defer></script>
    <script is:inline src={withBase('/rizoma-corpus.js')} defer></script>
  </body>
</html>
