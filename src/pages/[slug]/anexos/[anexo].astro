---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { listExploraciones, listAnexos, getExploracion } from '../../../lib/content';
import { loadAnexoTipos } from '../../../lib/data';
import { withBase } from '../../../lib/site';

export function getStaticPaths() {
  return listExploraciones().flatMap((doc) =>
    listAnexos(doc.slug).anexos.map((anexo) => ({
      params: { slug: doc.slug, anexo: anexo.slug },
      props: { slug: doc.slug, anexo: anexo.slug },
    }))
  );
}

const { slug, anexo: anexoSlug } = Astro.props;
const exploracion = getExploracion(slug);
if (!exploracion) throw new Error(`Exploración inexistente: ${slug}`);
const bundle = listAnexos(slug);
const anexo = bundle.anexos.find((item) => item.slug === anexoSlug);
if (!anexo) throw new Error(`Anexo inexistente: ${slug}/${anexoSlug}`);

const tipos = loadAnexoTipos();
const tipo = tipos.find((item) => item.id === anexo.data.tipo);
---

<Base
  title={anexo.data.title}
  description={anexo.data.procedencia}
  bodyClass="rizoma rizoma-anexo-page"
>
  <div class="rz-node-breadcrumb">
    <Breadcrumb exploracionUrl={withBase(`/${slug}/anexos/`)} exploracionTitle="Anexos" current={anexo.data.title} />
  </div>

  <header class="rz-page-head">
    <div class="rz-page-head__mark">
      <p class="rz-label">Anexo {anexo.data.order ?? '—'} / {tipo?.label ?? 'Anexo'}</p>
      <p class="rz-section-count">{anexo.data.estado ?? 'abierto'}{anexo.data.date && <><br />{anexo.data.date}</>}</p>
    </div>
    <div class="rz-page-head__body">
      <h1 class="rz-page-title">{anexo.data.title}</h1>
      <p class="rz-page-lede">{exploracion.data.title}</p>
    </div>
  </header>

  <div class="rz-anexo-layout">
    <article class="rz-anexo-body reading-body">
      {anexo.data.procedencia && <p class="rz-anexo-procedencia">{anexo.data.procedencia}</p>}
      <Fragment set:html={anexo.html} />

      {anexo.data.fuentes?.length ? (
        <section class="rz-anexo-fuentes" id="fuentes">
          <header>
            <p class="rz-label">Fuentes</p>
            <h2>Verificación</h2>
            <p>Cada fuente declara qué se verificó. Las que no se consultaron completas se marcan como tales.</p>
          </header>
          <ol>
            {anexo.data.fuentes.map((fuente) => (
              <li>
                <p class="rz-fuente-ref">
                  {fuente.autor}. <em>{fuente.titulo}</em>{fuente.anio ? ` (${fuente.anio})` : ''}.
                  {fuente.publicacion ? ` ${fuente.publicacion}.` : ''}
                </p>
                {fuente.url && <p class="rz-fuente-url"><a href={fuente.url}>{fuente.url}</a></p>}
                <p class="rz-fuente-meta">consultado {fuente.consultado}{fuente.tipo ? ` · ${fuente.tipo}` : ''}</p>
                {fuente.verifica && <p class="rz-fuente-verifica">{fuente.verifica}</p>}
              </li>
            ))}
          </ol>
        </section>
      ) : null}
    </article>

    <aside class="rz-anexo-side" aria-label="Ficha del anexo">
      <section>
        <p class="rz-label">Exploración</p>
        <p><a href={withBase(`/${slug}/`)}>{exploracion.data.title}</a></p>
      </section>
      <section>
        <p class="rz-label">Tipo</p>
        <p>{tipo?.label ?? 'Anexo'}</p>
      </section>
      <section>
        <p class="rz-label">Estado</p>
        <p>{anexo.data.estado ?? 'abierto'}</p>
      </section>
      {anexo.data.fuentes?.length ? (
        <section>
          <p class="rz-label">Fuentes</p>
          <a class="rz-text-link" href="#fuentes">Ver las fuentes <span aria-hidden="true">↓</span></a>
        </section>
      ) : null}
      <a class="rz-text-link" href={withBase(`/${slug}/anexos/`)}>Volver al aparato <span aria-hidden="true">←</span></a>
    </aside>
  </div>
</Base>
