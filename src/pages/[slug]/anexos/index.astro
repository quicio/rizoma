---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BackButton from '../../../components/BackButton.astro';
import SectionRail from '../../../components/SectionRail.astro';
import { listAnexos, listExploraciones, getExploracion } from '../../../lib/content';
import { loadAnexoTipos } from '../../../lib/data';
import { withBase } from '../../../lib/site';

export function getStaticPaths() {
  return listExploraciones()
    .filter((doc) => listAnexos(doc.slug).anexos.length > 0)
    .map((doc) => ({ params: { slug: doc.slug }, props: { slug: doc.slug } }));
}

const { slug } = Astro.props;
const exploracion = getExploracion(slug);
if (!exploracion) throw new Error(`Exploración inexistente: ${slug}`);
const tipos = loadAnexoTipos();
const anexos = exploracion.data.anexos || [];
---

<Base title={`Anexos · ${exploracion.data.title}`} description="El aparato de la exploración: objeciones, correcciones, fuentes, conceptos y derivaciones.">
  <Breadcrumb exploracionUrl={withBase(`/${slug}/`)} />

  <header class="expediente__head">
    <h1 class="expediente__title">Anexos</h1>
    <p class="expediente__question">Correcciones, fuentes, conceptos, objeciones y derivaciones.</p>
    <p class="expediente__meta">
      <span>Aparato · Exploración {exploracion.data.order}</span>
      <span>{exploracion.data.title}</span>
    </p>
  </header>

  <div class="expediente expediente--with-margin">
    <div class="expediente__body reading-body">
      <p class="anexos-intro">No todo anexo es una errata. Acá viven las correcciones, las fuentes, los conceptos, las objeciones y las derivaciones que no caben en la deriva. Cada anexo declara una operación; el tipo se elige por la pregunta que responde.</p>
      {exploracion.data.procedencia && <p class="anexos-procedencia">{exploracion.data.procedencia}</p>}

      {tipos.map((tipo) => {
        const grupo = anexos.filter((anexo) => anexo.tipo === tipo.id);
        if (!grupo.length) return null;
        return (
          <section class="anexos-grupo" id={tipo.id}>
            <h2>{tipo.label}</h2>
            <p class="anexos-grupo__question">{tipo.question}</p>
            <ul class="anexo-list">
              {grupo.map((anexo) => (
                <li>
                  <a href={withBase(`/${slug}/anexos/${anexo.url.split('/').filter(Boolean).at(-1)}/`)}>{anexo.title}</a>
                  {anexo.note && <p>{anexo.note}</p>}
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <p class="anexos-back"><a href={withBase(`/${slug}/`)}>← Volver a la exploración</a></p>
    </div>

    <aside class="expediente__margin" aria-label="Ficha del aparato">
      <section class="expediente__block">
        <h2 class="expediente__margin-title">Exploración</h2>
        <p class="anexo__margin-note"><a href={withBase(`/${slug}/`)}>{exploracion.data.title}</a></p>
      </section>

      <section class="expediente__block">
        <h2 class="expediente__margin-title">Tipos</h2>
        <ul class="anexo-list">
          {tipos.map((tipo) => {
            const grupo = anexos.filter((anexo) => anexo.tipo === tipo.id);
            return grupo.length ? <li><a href={`#${tipo.id}`}>{tipo.label}</a></li> : null;
          })}
        </ul>
      </section>
    </aside>
  </div>

  <BackButton />
  <SectionRail />
</Base>
