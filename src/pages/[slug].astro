---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BackButton from '../components/BackButton.astro';
import SectionRail from '../components/SectionRail.astro';
import Corpus from '../components/Corpus.astro';
import PresentacionMapa from '../components/PresentacionMapa.astro';
import Diagrama from '../components/Diagrama.astro';
import Respiro from '../components/Respiro.astro';
import { getExploracion, listExploraciones } from '../lib/content';
import { buildPresentacion, buildTrayectoria, loadAnexoTipos } from '../lib/data';
import { withBase, rizomaHref } from '../lib/site';

export function getStaticPaths() {
  return listExploraciones().map((doc) => ({ params: { slug: doc.slug }, props: { slug: doc.slug } }));
}

const { slug } = Astro.props;
const doc = getExploracion(slug);
if (!doc) throw new Error(`Exploración inexistente: ${slug}`);

const presentacion = buildPresentacion(doc);
const trayectoria = buildTrayectoria(doc);
const tipos = loadAnexoTipos();
const exploraciones = listExploraciones();

const chunks = doc.html.split('<h2');
const intro = chunks[0];
const sections = chunks.slice(1).map((chunk) => ({
  id: chunk.match(/^\s+id="([^"]+)"/)?.[1] ?? '',
  html: `<h2${chunk}`,
}));

function corpusFor(sectionId: string, html: string): string[] {
  if (doc.data.corpus_secciones?.length) {
    const map = doc.data.corpus_secciones.find((item) => item.seccion === sectionId);
    return map?.piezas ?? [];
  }
  return (doc.data.corpus || []).filter((item) => html.includes(item.url)).map((item) => item.url);
}

const anexos = doc.data.anexos || [];
const relacionadas = (doc.data.relacionadas || []).map((url) => ({
  url,
  title: exploraciones.find((item) => item.data.title && url.includes(item.slug))?.data.title ?? url,
}));
---

<Base title={doc.data.title} description={doc.data.summary || doc.data.question}>
  <Breadcrumb />

  <header class="expediente__head">
    <h1 class="expediente__title">{doc.data.title}</h1>
    {doc.data.question && <p class="expediente__question">{doc.data.question}</p>}
    {doc.data.summary && <p class="expediente__summary">{doc.data.summary}</p>}
    <p class="expediente__meta">
      <span>exploración <span class="expediente__meta-order">{doc.data.order}</span></span>
      <span>{doc.data.status}</span>
      {doc.data.fields && <span>{doc.data.fields.join(' · ')}</span>}
      {doc.data.updated && <span>actualizado {doc.data.updated}</span>}
    </p>
  </header>

  <PresentacionMapa presentacion={presentacion} />

  <div class="expediente">
    <div class="expediente__body reading-body">
      <div class="expediente__intro" id="introduccion">
        <p class="expediente__intro-eyebrow">Introducción</p>
        <Fragment set:html={intro} />
      </div>

      {
        sections.map((section) => {
          const urls = corpusFor(section.id, section.html);
          const respiros = presentacion.respiros[section.id] || [];
          return (
            <>
              {presentacion.diagrama?.antes_de === section.id && <Diagrama diagrama={presentacion.diagrama} />}
              {respiros.map((respiro) => <Respiro respiro={respiro} />)}
              <section class:list={['expediente__section', { 'expediente__section--with-corpus': urls.length > 0 }]}>
                <div class="expediente__section-body">
                  <Fragment set:html={section.html} />
                </div>
                {urls.length > 0 && (
                  <aside class="expediente__section-corpus" aria-label="Corpus de esta sección">
                    <p class="expediente__section-corpus-label">Corpus</p>
                    <Corpus items={doc.data.corpus} only={urls} compact />
                  </aside>
                )}
              </section>
            </>
          );
        })
      }
    </div>
  </div>

  <p class="expediente__end"><span>Fin de la deriva</span></p>

  <section class="expediente__apparatus" aria-labelledby="expediente-apparatus-title">
    <header class="expediente__apparatus-head">
      <h2 class="expediente__apparatus-title" id="expediente-apparatus-title">Aparato</h2>
      <p class="expediente__apparatus-intro">Las obras que sostienen la deriva, el vocabulario que comparte y las huellas de su edición.</p>
    </header>

    <details class="expediente__apparatus-details" open={presentacion.aparato_abierto} data-keep-closed={!presentacion.aparato_abierto ? '' : undefined}>
      <summary class="expediente__apparatus-summary">
        <span class="expediente__apparatus-summary-label">Corpus, nodos y versiones</span>
        <span class="expediente__apparatus-summary-count">
          {doc.data.corpus?.length ?? 0} piezas · {doc.data.nodos?.length ?? 0} nodos{anexos.length ? ` · ${anexos.length} anexos` : ''}
        </span>
      </summary>

      <div class="expediente__apparatus-grid">
        <div class="expediente__apparatus-main">
          {doc.data.corpus?.length ? (
            <section class="expediente__apparatus-block">
              <h3 class="expediente__apparatus-block-title">Corpus</h3>
              <Corpus items={doc.data.corpus} />
            </section>
          ) : null}
        </div>

        <div class="expediente__apparatus-side">
          {doc.data.nodos?.length ? (
            <section class="expediente__apparatus-block">
              <h3 class="expediente__apparatus-block-title">Nodos</h3>
              <ul class="expediente__nodos">
                {doc.data.nodos.map((nodo) => (
                  <li><a href={`${withBase('/nodos/')}#${nodo.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{nodo}</a></li>
                ))}
              </ul>
            </section>
          ) : null}

          {relacionadas.length ? (
            <section class="expediente__apparatus-block">
              <h3 class="expediente__apparatus-block-title">Relacionadas</h3>
              <ul class="expediente__related">
                {relacionadas.map((item) => (
                  <li><a href={rizomaHref(item.url)}>{item.title}</a></li>
                ))}
              </ul>
            </section>
          ) : null}

          {anexos.length ? (
            <section class="expediente__apparatus-block">
              <h3 class="expediente__apparatus-block-title">Anexos</h3>
              {tipos.map((tipo) => {
                const grupo = anexos.filter((anexo) => anexo.tipo === tipo.id);
                if (!grupo.length) return null;
                return (
                  <>
                    <p class="anexo-list__label">{tipo.label}</p>
                    <ul class="anexo-list">
                      {grupo.map((anexo) => (
                        <li>
                          <a href={rizomaHref(anexo.url)}>{anexo.title}</a>
                          {anexo.note && <p>{anexo.note}</p>}
                        </li>
                      ))}
                    </ul>
                  </>
                );
              })}
              <a class="expediente__history-link" href={`${withBase(`/${doc.slug}/anexos/`)}`}>Ver el aparato completo →</a>
            </section>
          ) : null}

          {trayectoria?.cartografia ? (
            <section class="expediente__apparatus-block">
              <h3 class="expediente__apparatus-block-title">Trayectoria</h3>
              {trayectoria.frentes.length > 0 && (
                <p class="expediente__trayectoria-front">
                  Frente: {trayectoria.frentes.map((frente) => frente.nombre_canonico).join(' · ')}
                </p>
              )}
              <a class="expediente__history-link" href={withBase(`/trayectoria/${trayectoria.cartografia.id}/`)}>Ver trayectoria →</a>
            </section>
          ) : null}

          <section class="expediente__apparatus-block">
            <h3 class="expediente__apparatus-block-title">Evolución</h3>
            <a class="expediente__history-link" href={`${withBase(`/${doc.slug}/historial/`)}`}>Ver historial de versiones →</a>
          </section>
        </div>
      </div>

      {doc.data.procedencia && (
        <details class="expediente__apparatus-colophon">
          <summary>Procedencia</summary>
          <p class="expediente__procedencia">{doc.data.procedencia}</p>
        </details>
      )}
    </details>
  </section>

  <BackButton />
  <SectionRail />
</Base>

<script is:inline src={withBase('/rizoma-apparatus.js')} defer></script>
