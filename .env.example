RIZOMA_SITE=https://kndl.quicio.qzz.io

# Subruta del build. Embebido en kndl: /rizoma. Independiente: /
RIZOMA_BASE=/rizoma

# Origen de KNDL para los enlaces al corpus (poemas, código, dispositivos).
# Vacío = enlaces root-relative (modo embebido).
# Ejemplo independiente: https://kndl.quicio.qzz.io
RIZOMA_KNDL_ORIGIN=

# GA4 opcional. Vacío = sin analytics.
PUBLIC_GA4_ID=
