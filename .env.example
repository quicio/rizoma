# Origen canónico del sitio independiente.
RIZOMA_SITE=https://rizoma.quicio.org

# Subruta del build. Dominio propio: /. kndl ya no copia el sitio; una subruta es opcional.
RIZOMA_BASE=/

# Origen de KNDL para los enlaces al corpus (poemas, código, dispositivos).
# Vacío = enlaces root-relative, resueltos por el origen que sirva el sitio.
RIZOMA_KNDL_ORIGIN=https://kndl.quicio.org

# GA4 opcional. Vacío = sin analytics.
PUBLIC_GA4_ID=
